# Admin dashboard password (choose your own)
ADMIN_PASSWORD=change-me

# Random long string used to sign the admin login cookie
JWT_SECRET=replace-with-a-long-random-string

# Google Cloud OAuth client (create in Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI must be: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/auth/google/callback

# Root Google Drive folder ID that will contain one subfolder per event
# (open the folder in Drive, copy the id from the URL)
DRIVE_ROOT_FOLDER_ID=

# fal.ai API key for AI edits (fal.ai -> Dashboard -> Keys). Server-side only.
FAL_KEY=
# Optional: output size for AI edits. 1K = $0.08/edit, 2K = $0.12, 4K = $0.16
# FAL_RESOLUTION=1K
# Optional: swap the model for every preset (e.g. fal-ai/nano-banana-pro/edit)
# FAL_MODEL=fal-ai/nano-banana-2/edit

# These are added automatically when you attach the Vercel KV storage
# integration to this project in the Vercel dashboard - no need to set by hand.
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
